save-exact=true
package-lock=true

# Don't run dependency lifecycle scripts on install. A postinstall runs
# arbitrary code with full access to the machine, and this project needs none
# of them: the only one in the tree is @sentry/cli's binary download, and the
# sentry-cli we actually invoke is the mise-pinned one
# (fastlane/lib/sourcemaps.rb runs `mise x -- sentry-cli`).
#
# This also makes CI match a developer machine that sets ignore-scripts in
# ~/.npmrc, a common supply-chain precaution. Without it the two disagree about
# what is installed, and that divergence hides real breakage: react-native-ios-
# utilities 5.2.0 ships no build output and relies on its own prepare script to
# produce it, so its type errors appeared only in CI.
#
# Consequence: npm no longer runs this project's own `prepare` hook either, so
# contrib/*.patch must be applied explicitly with `mise run prepare` after every
# `npm ci`. Every workflow that installs now does so.
ignore-scripts=true
