ement(\"div\");\n      popup.classList.add(\"popup\");\n      let img = document.createElement(\"img\");\n      img.src = imageSrc;\n      popup.appendChild(img);\n\n      let nowPlayingDiv = document.createElement(\"div\");\n      nowPlayingDiv.innerHTML = \"<span class='red-text'>\" + showName + \"</span>\";\n      if (genre != \"\") {\n        nowPlayingDiv.innerHTML += \"<br /><span style='font-size: 15px;'>Genre: </span><span class='red-text-small'>\" + genre + \"</span>\";\n      }\n      \n      nowPlayingDiv.appendChild(popup);\n      document.getElementById(\"now-playing\").appendChild(nowPlayingDiv);\n\n      // Update \"now playing\" message every minute\n      setInterval(function() {\n        let currentTime = new Date();\n        let currentDay = currentTime.getDay();\n        let currentHour = currentTime.getHours();\n        let showName = nowPlaying[currentDay][currentHour].name;\n        let genre = (nowPlaying[currentDay][currentHour].hasOwnProperty(\"genre\")) ? nowPlaying[currentDay][currentHour].genre : \"\";\n        let imageSrc = (nowPlaying[currentDay][currentHour].hasOwnProperty(\"poster\")) ? nowPlaying[currentDay][currentHour].poster : \"\";\n\n        // If there is no image provided, default to the cow\n        if (imageSrc == \"\") {\n          imageSrc = \"https://www.kstoradio.org/wp-content/uploads/sites/1178/2023/12/cropped-KSTO-Cow-w_-Text.png\"\n        }\n        let nowPlayingDiv = document.createElement(\"div\");\n        nowPlayingDiv.innerHTML = \"<span class='red-text'>\" + showName + \"</span>\";\n        if (genre != \"\") {\n          nowPlayingDiv.innerHTML += \"<br /><span style='font-size: 15px;'>Genre: </span><span class='red-text-small'>\" + genre + \"</span>\";\n        }\n        img.src = imageSrc;\n      }, 60000); // 60000 milliseconds = 1 minute\n    </script>\n  </body>\n</html>\n",
