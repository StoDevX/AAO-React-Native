      "ExternalDescriptionStr": "<p style=\"margin-top:11pt;margin-bottom:0pt;padding:0pt 0pt 11pt 0pt\"><span style=\"font-weight:700;font-style:normal;text-decoration:none\">Job Title:</span><span style=\"font-weight:400;font-style:normal;text-decoration:none\"> Admissions Fellow (WS-ST2)</span></p>\n<p style=\"margin-top:0pt;margin-bottom:0pt;padding:0pt 0pt 11pt 0pt\"><span style=\"font-weight:700;font-style:normal;text-decoration:none\">Classification: </span><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Student Employee (non-exempt)</span></p>\n<p style=\"margin-top:0pt;margin-bottom:0pt;padding:0pt 0pt 11pt 0pt\"><span style=\"font-weight:700;font-style:normal;text-decoration:none\">Name and Address of Employer: </span><span style=\"font-weight:400;font-style:normal;text-decoration:none\">St. Olaf College, 1520 St. Olaf Ave, Northfield, MN 55057</span></p>\n<p style=\"margin-top:0pt;margin-bottom:0pt;padding:0pt 0pt 11pt 0pt\"><span style=\"font-weight:700;font-style:normal;text-decoration:none\">Department Name:</span><span style=\"font-weight:400;font-style:normal;text-decoration:none\"> Admissions</span></p>\n<p style=\"margin-top:0pt;margin-bottom:0pt;padding:0pt 0pt 11pt 0pt\"><span style=\"font-weight:700;font-style:normal;text-decoration:none\">Unit Number (5 digits):&nbsp;</span></p>\n<p style=\"margin-top:0pt;margin-bottom:0pt;padding:0pt 0pt 11pt 0pt\"><span style=\"font-weight:700;font-style:normal;text-decoration:none\">Length of Position: </span><span style=\"font-weight:400;font-style:normal;text-decoration:none\">See Employment Authorization</span><span style=\"font-weight:700;font-style:normal;text-decoration:none\">&nbsp;</span></p>\n<p style=\"margin-top:0pt;margin-bottom:0pt;padding:0pt 0pt 11pt 0pt\"><span style=\"font-weight:700;font-style:normal;text-decoration:none\">Contact Person/Supervisor: </span><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Assistant Director of Enrollment Operations</span></p>\n<p style=\"margin-top:0pt;margin-bottom:10pt\"><span style=\"font-weight:700;font-style:normal;text-decoration:none\">Wage Range:&nbsp;</span>$12.00-13.00/hr.</p>\n<p style=\"margin-top:0pt;margin-bottom:0pt;padding:1pt 0pt 11pt 0pt\"><span style=\"font-weight:700;font-style:normal;text-decoration:none\">Description of the Position: (Purpose of the Position):</span><span style=\"font-weight:400;font-style:normal;text-decoration:none\">&nbsp;</span></p>\n<p style=\"margin-top:0pt;margin-bottom:0pt;padding:0pt 0pt 11pt 0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Members of the Admissions Student Work Team are professionals responsible for many of the activities related to the efficient operation of the Admissions Office.&nbsp; This includes, but is not limited to, assisting at the front desk, answering phones in the student workroom, creating visit schedules, leading campus tours, prepping for on campus event days, assisting in the execution of on campus events and miscellaneous projects as assigned.</span></p>\n<p style=\"margin-top:0pt;margin-bottom:11pt\"><span style=\"font-weight:700;font-style:normal;text-decoration:none\">Transferable Skills:</span><span style=\"font-weight:400;font-style:normal;text-decoration:none\">&nbsp;</span></p>\n<ul style=\"margin-top:0;margin-bottom:0\">\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:11pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Oral/Written Communication</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Critical Thinking/Problem Solving</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Teamwork/Collaboration</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Digital Technology</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Professionalism/Work Ethic</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:11pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Leadership</span></p></li>\n</ul>\n<p style=\"margin-top:11pt;margin-bottom:11pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">&nbsp;</span><span style=\"font-weight:700;font-style:normal;text-decoration:none\">Duties and Responsibilities:&nbsp;</span></p>\n<ul style=\"margin-top:0;margin-bottom:0\">\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:11pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Provide daily campus tours to prospective students and parents</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Assist with the front desk operations</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Assist with telephone and visit office work</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Assist during on campus events</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">General office duties, including research, data entry, etc.</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:11pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Miscellaneous projects as assigned</span></p></li>\n</ul>\n<p style=\"margin-top:11pt;margin-bottom:11pt\"><span style=\"font-weight:700;font-style:normal;text-decoration:none\">Qualifications: (Education/Experience/Skills)</span></p>\n<ul style=\"margin-top:0;margin-bottom:0\">\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Experience as a Junior Admissions Fellow or similar experience is required</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Excellent interpersonal, organizational and communication skills</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Strong sense of initiative and self-direction</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">A high level of motivation, positive attitude, sense of humor, and service orientation</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">An awareness of the needs and aspirations of a highly selective, residential, liberal arts college</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:0pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Ability to function well in an atmosphere that promotes teamwork as well as initiative and independence</span></p></li>\n <li style=\"list-style-type:disc;font-weight:400;font-style:normal;text-decoration:none\">\n  <p style=\"margin-top:0pt;margin-bottom:11pt\"><span style=\"font-weight:400;font-style:normal;text-decoration:none\">Experience using data and technology that contributes to a data-informed enrollment environment&nbsp;</span></p></li>\n</ul>\n<p style=\"margin-top:11pt;margin-bottom:0pt;padding:0pt 0pt 11pt 0pt\"></p>\n<p style=\"margin-top:11pt;margin-bottom:11pt\"><span style=\"font-weight:700;font-style:normal;text-decoration:none\">This job description is for general information purposes.&nbsp; It is not intended to list all duties and responsibilities of the position.&nbsp; This job description is subject to change at any time by St. Olaf College, with or without prior notice.</span></p>",
