amends "package://github.com/jdx/hk/releases/download/v1.41.0/hk@1.41.0#/Config.pkl"

// hk runs steps at once unless one depends on another. Each step is its own
// `mise run`, so tsc and jest skip their own bundle-data and wait for the one
// step that writes docs/: otherwise one could read a file the other is halfway
// through writing.
local checks = new Mapping<String, Step> {
  ["oxfmt"] {
    check = "mise run format:check"
    fix = "mise run format"
  }
  ["oxlint"] {
    check = "mise run lint"
    fix = "mise run lint -- --fix"
  }
  ["bundle-data"] {
    check = "mise run bundle-data"
  }
  ["tsc"] {
    check = "mise run --skip-deps tsc"
    depends = List("bundle-data")
  }
  ["jest"] {
    check = "mise run --skip-deps test:jest ::: test:node"
    depends = List("bundle-data")
  }
}

// oxlint's fixes rewrite the source, so under `hk fix` every step that reads
// it waits for them: oxfmt formats them, and tsc and jest check them.
local fixes = (checks) {
  ["oxfmt"] { depends = List("oxlint") }
  ["tsc"] { depends = List("oxlint", "bundle-data") }
  ["jest"] { depends = List("oxlint", "bundle-data") }
}

hooks {
  // A commit takes what was staged or nothing: code that is unformatted or
  // fails a lint rule stops the commit, and `hk fix` is the way to fix it.
  ["pre-commit"] {
    fix = false
    stash = "git"
    steps = checks
  }
  ["fix"] {
    fix = true
    steps = fixes
  }
  ["check"] {
    steps = checks
  }
}
