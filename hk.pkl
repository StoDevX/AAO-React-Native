amends "package://github.com/jdx/hk/releases/download/v1.41.0/hk@1.41.0#/Config.pkl"

// hk runs steps at once unless one depends on another. Under `hk fix`, every
// step that reads the source waits for oxlint's fixes, so oxfmt formats them
// and tsc and jest check them.
local linters = new Mapping<String, Step> {
  ["oxfmt"] {
    check = "mise run format:check"
    fix = "mise run format"
    depends = List("oxlint")
  }
  ["oxlint"] {
    check = "mise run lint"
    fix = "mise run lint -- --fix"
  }
  ["tsc"] {
    check = "mise run tsc"
    depends = List("oxlint")
  }
  ["jest"] {
    check = "mise run test"
    depends = List("oxlint")
  }
}

hooks {
  // A commit takes what was staged or nothing: code that is unformatted or
  // fails a lint rule stops the commit, and `hk fix` is the way to fix it.
  ["pre-commit"] {
    fix = false
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
