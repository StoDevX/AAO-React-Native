coverage

# fastlane specific
fastlane/report.xml

# snapshot's generated screenshots
fastlane/Preview.html
fastlane/screenshots

# scan's temporary files
fastlane/test_output

# generated files. Git cannot re-include a path whose parent directory is
# excluded, so exclude the *contents* of docs/ and carve out superpowers/.
/docs/*
!/docs/superpowers/

# Deployment keys
android/app/signing.properties
android/app/upload-keystore.properties
fastlane/play-private-key.json

# vim temp files
*.swp

# rubygems bundle
/.bundle/
/vendor/bundle/

# generated logs files in CI
/logs
.superpowers/

# agent worktrees: multi-GB of node_modules, Pods and build output. Jujutsu
# tracks new files automatically, so leaving these visible makes it try to
# snapshot every worktree.
/.claude/worktrees/

# written by Xcode Cloud when it runs locally

# App Store Connect API key, copied in at runtime by fastlane from the match repo
fastlane/AuthKey_*.p8

# Generated by `mise run prebuild` from app.config.ts and plugins/.
# Never hand-edit; changes belong in app.config.ts or a config plugin.
/ios/

# Expo CLI scratch space
/.expo/
