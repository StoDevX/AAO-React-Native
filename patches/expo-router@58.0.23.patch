+        // Only hand UIKit a new list when the items themselves changed: an
+        // update that only touched a menu's contents has already been applied
+        // to the item in place.
+        let current = controller.toolbarItems ?? []
+        let unchanged = current.count == items.count
+          && zip(current, items).allSatisfy { $0 === $1 }
+        if current.contains(where: { $0.menu != nil }) { // EXPERIMENT probe
+          NSLog("[menu-probe] expo-router toolbar update: \(unchanged ? "kept" : "REPLACED") the menu item")
+        }
+        if !unchanged {
+          controller.setToolbarItems(items, animated: true)
+        }
+        if controller.navigationController?.isToolbarHidden != false {
