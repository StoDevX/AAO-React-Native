+    scrollView = candidate
+    restingOffset = candidate.contentOffset.x
+    observation = candidate.observe(\.contentOffset) { [weak self] _, _ in
+      // The last offset of a swipe is written while the scroll view still
+      // calls itself decelerating, so look again once that frame is done.
+      DispatchQueue.main.async { self?.checkForRest() }
+    }
+  }
+
+  private func checkForRest() {
+    guard let scrollView,
+          !scrollView.isTracking,
+          !scrollView.isDragging,
+          !scrollView.isDecelerating else { return }
+    let width = scrollView.bounds.width
+    guard width > 0 else { return }
+    let offset = scrollView.contentOffset.x
+    let page = offset / width
+    guard abs(page - page.rounded()) < 0.001, offset != restingOffset else { return }
+    restingOffset = offset
+    onSettle?()
+  }
+}
+
+/// Hands a page's enclosing paging scroll view to a tracker.
+///
+/// SwiftUI does not expose the scroll view a page-style `TabView` is built
+/// on, so a page looks for it among its own ancestors. A page's own vertical
+/// scroll view is passed over, since it does not page.
+private struct PagingScrollViewFinder: UIViewRepresentable {
+  let tracker: PageSettleTracker
+
+  func makeUIView(context: Context) -> FinderView {
+    let view = FinderView()
+    view.tracker = tracker
+    view.isUserInteractionEnabled = false
+    return view
+  }
+
+  func updateUIView(_ uiView: FinderView, context: Context) {
+    uiView.tracker = tracker
+  }
+
+  final class FinderView: UIView {
+    weak var tracker: PageSettleTracker?
+
+    override func didMoveToWindow() {
+      super.didMoveToWindow()
+      guard window != nil else { return }
+      var ancestor = superview
+      while let view = ancestor {
+        if let scrollView = view as? UIScrollView, scrollView.isPagingEnabled {
+          tracker?.attach(scrollView)
+          return
+        }
+        ancestor = view.superview
+      }
+    }
+  }
+}
