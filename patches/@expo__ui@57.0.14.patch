@@ -1157,6 +1173,23 @@ internal enum TextLinePattern: String, Enumerable {
   case dashDotDot
 }
 
+@available(iOS 16.0, macOS 13.0, tvOS 16.0, *)
+internal extension TextLinePattern {
+  /// The SwiftUI pattern this maps to. `TextUnderLine` and `TextStrikeThrough`
+  /// each still switch over all five cases inline, upstream's own code and
+  /// left alone; the nested-`Text` arms below need the same mapping, so it is
+  /// factored out here rather than written inline a third time.
+  var lineStyle: Text.LineStyle.Pattern {
+    switch self {
+    case .solid: return .solid
+    case .dash: return .dash
+    case .dot: return .dot
+    case .dashDot: return .dashDot
+    case .dashDotDot: return .dashDotDot
+    }
+  }
+}
+
 internal struct TextUnderLine: ViewModifier, Record {
