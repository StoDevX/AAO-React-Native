--- a/ios/Modifiers/ViewModifierRegistry.swift
+++ b/ios/Modifiers/ViewModifierRegistry.swift
@@ -1157,6 +1157,23 @@ internal enum TextLinePattern: String, Enumerable {
   case dashDotDot
 }
 
+@available(iOS 16.0, macOS 13.0, tvOS 16.0, *)
+internal extension TextLinePattern {
+  /// The SwiftUI pattern this maps to. `TextUnderLine` and `TextStrikeThrough`
+  /// each still switch over all five cases inline, upstream's own code and
+  /// left alone; the nested-`Text` arms below need the same mapping, so it is
+  /// factored out here rather than written inline a third time.
+  var lineStyle: Text.LineStyle.Pattern {
+    switch self {
+    case .solid: return .solid
+    case .dash: return .dash
+    case .dot: return .dot
+    case .dashDot: return .dashDot
+    case .dashDotDot: return .dashDotDot
+    }
+  }
+}
+
 internal struct TextUnderLine: ViewModifier, Record {
   @Field var isActive: Bool = false
   @Field var pattern: TextLinePattern = .solid
@@ -1599,6 +1615,18 @@ public class ViewModifierRegistry {
           return text.foregroundColor(color)
       } 
       return text
+    case "strikethrough":
+      guard #available(iOS 16.0, macOS 13.0, tvOS 16.0, *),
+            let modifier = try? TextStrikeThrough(from: params, appContext: appContext)
+      else { return text }
+      return text.strikethrough(
+        modifier.isActive, pattern: modifier.pattern.lineStyle, color: modifier.color)
+    case "underline":
+      guard #available(iOS 16.0, macOS 13.0, tvOS 16.0, *),
+            let modifier = try? TextUnderLine(from: params, appContext: appContext)
+      else { return text }
+      return text.underline(
+        modifier.isActive, pattern: modifier.pattern.lineStyle, color: modifier.color)
     default:
       #if DEBUG
       return Text(" ['\(type)' not supported for nested Text]").foregroundColor(.red)
