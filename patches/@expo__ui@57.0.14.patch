+/// Attaches the letter a native A-Z jumplist rail shows for this `Section`.
+/// `sectionIndexLabel(_:)` is iOS 26+ only; below that this is a no-op, so the
+/// list looks exactly as it did before the patch.
+internal struct SectionIndexLabelModifier: ViewModifier, Record {
+  @Field var label: String = ""
+
+  @ViewBuilder
+  func body(content: Content) -> some View {
+    if #available(iOS 26.0, *) {
+      content.sectionIndexLabel(label)
+    } else {
+      content
+    }
+  }
+}
