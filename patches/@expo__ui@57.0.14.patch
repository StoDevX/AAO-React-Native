+import type { ColorValue } from 'react-native';
+import { type CommonViewModifierProps } from '../types';
+/**
+ * `HangingText` is drawn by UIKit, so SwiftUI `font` and `foregroundStyle`
+ * modifiers do not reach its text: its own `serif`, `color`, `linkColor` and
+ * `lineSpacing` props set it. Layout modifiers such as `padding` still apply.
+ */
