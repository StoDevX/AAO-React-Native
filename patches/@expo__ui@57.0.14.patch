+++ b/ios/HangingTextView.swift
@@ -0,0 +1,163 @@
+// A line of text whose wrapped continuation lines sit further in than its first
+// line -- a hanging indent. SwiftUI's `Text` has no paragraph style, so this
+// draws through a read-only UITextView with an NSParagraphStyle instead, which
+// also keeps its links tappable and announced as links.
+
+import SwiftUI
+import UIKit
+import ExpoModulesCore
+
+public final class HangingTextViewProps: UIBaseViewProps {
+  /// Inline Markdown: emphasis, strong and links.
+  @Field public var text: String = ""
+  /// How far continuation lines sit past the first, in points.
+  @Field public var hangingIndent: Double = 0
+  /// Extra space between wrapped lines, in points.
+  @Field public var lineSpacing: Double = 0
+  @Field public var color: UIColor?
+  @Field public var linkColor: UIColor?
+  /// Sets the body text style in the serif design (New York) rather than the system face.
+  @Field public var serif: Bool = false
+
+  override var defaultFrameAlignment: Alignment { .leading }
+}
+
+/// The ASCII punctuation CommonMark lets a backslash escape.
+private let escapable = Set("!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~")
+
+/// Markdown source with its backslash escapes removed, for when it cannot be parsed.
+private func unescaped(_ markdown: String) -> String {
+  var result = ""
+  var pendingBackslash = false
+  for character in markdown {
+    if pendingBackslash {
+      if !escapable.contains(character) { result.append("\\") }
+      result.append(character)
+      pendingBackslash = false
+    } else if character == "\\" {
+      pendingBackslash = true
+    } else {
+      result.append(character)
+    }
+  }
+  if pendingBackslash { result.append("\\") }
+  return result
+}
+
+public struct HangingTextView: ExpoSwiftUI.View {
+  @ObservedObject public var props: HangingTextViewProps
+  @Environment(\.dynamicTypeSize) private var dynamicTypeSize
+
+  public init(props: HangingTextViewProps) {
+    self.props = props
+  }
+
+  public var body: some View {
+    HangingLabel(text: attributedText(), linkColor: props.linkColor ?? UIColor.link)
+  }
+
+  private func bodyFont(bold: Bool, italic: Bool) -> UIFont {
+    var traits = UITraitCollection.current
+    if #available(iOS 17.0, tvOS 17.0, *) {
+      traits = UITraitCollection(preferredContentSizeCategory: UIContentSizeCategory(dynamicTypeSize))
+    }
+    var descriptor = UIFontDescriptor.preferredFontDescriptor(withTextStyle: .body, compatibleWith: traits)
+    if props.serif, let serif = descriptor.withDesign(.serif) {
+      descriptor = serif
+    }
+    var symbolic = descriptor.symbolicTraits
+    if bold { symbolic.insert(.traitBold) }
+    if italic { symbolic.insert(.traitItalic) }
+    descriptor = descriptor.withSymbolicTraits(symbolic) ?? descriptor
+    return UIFont(descriptor: descriptor, size: 0)
+  }
+
+  private func attributedText() -> NSAttributedString {
+    let options = AttributedString.MarkdownParsingOptions(
+      interpretedSyntax: .inlineOnlyPreservingWhitespace
+    )
+    let parsed = (try? AttributedString(markdown: props.text, options: options))
+      ?? AttributedString(unescaped(props.text))
+
+    let paragraph = NSMutableParagraphStyle()
+    paragraph.firstLineHeadIndent = 0
+    paragraph.headIndent = props.hangingIndent
+    paragraph.lineSpacing = props.lineSpacing
+    paragraph.lineBreakMode = .byWordWrapping
+
+    let result = NSMutableAttributedString()
+    for run in parsed.runs {
+      let intent = run.inlinePresentationIntent ?? []
+      var attributes: [NSAttributedString.Key: Any] = [
+        .font: bodyFont(bold: intent.contains(.stronglyEmphasized), italic: intent.contains(.emphasized)),
+        .paragraphStyle: paragraph,
+        .foregroundColor: props.color ?? UIColor.label,
+      ]
+      // The text view draws a link in its `linkTextAttributes`, and opens it when tapped.
+      if let link = run.link {
+        attributes[.link] = link
+      }
+      result.append(NSAttributedString(string: String(parsed[run.range].characters), attributes: attributes))
+    }
+    return result
+  }
+}
+
+/// A read-only, unscrolled UITextView that tells SwiftUI how tall it is at the width it is offered.
+private struct HangingLabel: UIViewRepresentable {
+  let text: NSAttributedString
+  let linkColor: UIColor
+
+  func makeCoordinator() -> Coordinator {
+    Coordinator()
+  }
+
+  func makeUIView(context: Context) -> UITextView {
+    let view = UITextView()
+    view.delegate = context.coordinator
+    view.isEditable = false
+    view.isScrollEnabled = false
+    view.backgroundColor = .clear
+    view.textContainerInset = .zero
+    view.textContainer.lineFragmentPadding = 0
+    view.textContainer.lineBreakMode = .byWordWrapping
+    view.adjustsFontForContentSizeCategory = false
+    view.setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
+    view.setContentHuggingPriority(.defaultLow, for: .horizontal)
+    return view
+  }
+
+  func updateUIView(_ view: UITextView, context: Context) {
+    context.coordinator.openURL = context.environment.openURL
+    view.linkTextAttributes = [.foregroundColor: linkColor]
+    view.attributedText = text
+  }
+
+  func sizeThatFits(_ proposal: ProposedViewSize, uiView view: UITextView, context: Context) -> CGSize? {
+    let width = proposal.width ?? .greatestFiniteMagnitude
+    let fitted = view.sizeThatFits(CGSize(width: width, height: .greatestFiniteMagnitude))
+    return CGSize(width: min(width, ceil(fitted.width)), height: ceil(fitted.height))
+  }
+
+  /// Sends a tapped web link to SwiftUI's `openURL` action, as a SwiftUI `Text` link goes, so an
+  /// `openURLAction` modifier above this view decides where it opens. A UITextView otherwise
+  /// opens its links itself, in Safari. Any other scheme, such as `mailto:`, keeps the text
+  /// view's own action.
+  final class Coordinator: NSObject, UITextViewDelegate {
+    var openURL: OpenURLAction?
+
+    // The pod builds for older iOS than the app, which targets 27.0, so the app always has this.
+    @available(iOS 17.0, *)
+    func textView(
+      _ textView: UITextView,
+      primaryActionFor textItem: UITextItem,
+      defaultAction: UIAction
+    ) -> UIAction? {
+      guard case .link(let url) = textItem.content,
+            let scheme = url.scheme?.lowercased(), scheme == "http" || scheme == "https",
+            let openURL
+      else { return defaultAction }
+      return UIAction { _ in openURL(url) }
+    }
+  }
+}
