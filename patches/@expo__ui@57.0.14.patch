diff --git a/src/swift-ui/HangingText/index.tsx b/src/swift-ui/HangingText/index.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..329ae7cf80f38a41207669e74926ad8d2f2fb88d
--- /dev/null
+++ b/src/swift-ui/HangingText/index.tsx
@@ -0,0 +1,55 @@
+import { requireNativeView } from 'expo';
+import type { ColorValue } from 'react-native';
+
+import { createViewModifierEventListener } from '../modifiers/utils';
+import { type CommonViewModifierProps } from '../types';
+
+export interface HangingTextProps extends CommonViewModifierProps {
+  /**
+   * Inline Markdown: emphasis, strong emphasis and links.
+   */
+  children: string;
+  /**
+   * How far wrapped continuation lines sit past the first line, in points.
+   */
+  hangingIndent: number;
+  /**
+   * Extra space between wrapped lines, in points.
+   */
+  lineSpacing?: number;
+  /**
+   * The text colour.
+   */
+  color?: ColorValue;
+  /**
+   * The colour of a link's text.
+   */
+  linkColor?: ColorValue;
+  /**
+   * Sets the body text style in the serif design rather than the system face.
+   */
+  serif?: boolean;
+}
+
+type NativeHangingTextProps = Omit<HangingTextProps, 'children'> & { text: string };
+
+const HangingTextNativeView: React.ComponentType<NativeHangingTextProps> = requireNativeView(
+  'ExpoUI',
+  'HangingTextView'
+);
+
+/**
+ * Body text whose wrapped lines sit `hangingIndent` points past its first
+ * line, drawn by a `UILabel` with a paragraph style, which SwiftUI's `Text`
+ * does not have. It follows Dynamic Type.
+ */
+export function HangingText({ children, modifiers, ...props }: HangingTextProps) {
+  return (
+    <HangingTextNativeView
+      text={children}
+      modifiers={modifiers}
+      {...(modifiers ? createViewModifierEventListener(modifiers) : undefined)}
+      {...props}
+    />
+  );
+}
