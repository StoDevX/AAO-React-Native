+    /**
+     * Centres the navigation button and the action menu on the title's line.
+     * Toolbar places both by their own measure -- the 56dp button, and the
+     * menu holding a search action, from the top of a bar that may be shorter
+     * or taller -- so the back arrow and the search icon sat below the title
+     * and the header's own actions, which centre in the bar. Without a title
+     * they centre in the bar.
+     */
+    private fun alignNavigationButton() {
+        var titleView: TextView? = null
+        val toAlign = mutableListOf<android.view.View>()
+        for (index in 0 until childCount) {
+            val child = getChildAt(index)
+            if (child is ImageButton && child.drawable != null && child.drawable === navigationIcon) {
+                toAlign.add(child)
+            } else if (child is ActionMenuView) {
+                toAlign.add(child)
+            } else if (titleView == null && child is TextView && title != null && child.text?.toString() == title?.toString()) {
+                titleView = child
+            }
+        }
+        val target =
+            titleView?.let { (it.top + it.bottom) / 2 }
+                ?: ((paddingTop + height - paddingBottom) / 2)
+        for (view in toAlign) {
+            val offset = target - (view.top + view.bottom) / 2
+            if (offset != 0) {
+                view.offsetTopAndBottom(offset)
+            }
+        }
+    }
+
