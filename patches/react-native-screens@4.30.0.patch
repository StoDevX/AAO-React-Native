+/// Whether `current` already shows what `proposed` would: the same items, or
+/// items built from equal configurations. A fixed space is rebuilt on every
+/// update, so two of the same width count as the same.
+static BOOL RNSBarButtonItemsAreEquivalent(NSArray<UIBarButtonItem *> *current, NSArray<UIBarButtonItem *> *proposed)
+{
+  NSUInteger count = current.count;
+  if (count != proposed.count) {
+    return NO;
+  }
+  for (NSUInteger i = 0; i < count; i++) {
+    UIBarButtonItem *a = current[i];
+    UIBarButtonItem *b = proposed[i];
+    if (a == b) {
+      continue;
+    }
+    if ([a isKindOfClass:[RNSBarButtonItem class]] && [b isKindOfClass:[RNSBarButtonItem class]]) {
+      NSDictionary *configA = ((RNSBarButtonItem *)a).rnsConfig;
+      NSDictionary *configB = ((RNSBarButtonItem *)b).rnsConfig;
+      if (configA != nil && [configA isEqualToDictionary:configB]) {
+        continue;
+      }
+      return NO;
+    }
+    if ([a class] == [UIBarButtonItem class] && [b class] == [UIBarButtonItem class] && a.customView == nil &&
+        b.customView == nil && a.width == b.width && a.title == nil && b.title == nil && a.image == nil &&
+        b.image == nil) {
+      continue;
+    }
+    return NO;
+  }
+  return YES;
+}
