d="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,452][169,515]" /><node index="1" text="The Academic Advising Center provides support in exploring academic goals within the context of possible career and life-long goals. The Center supports both faculty advisors and their advisees in providing the necessary information and skills to fulfill graduation, general education and major requirements.&#10;&#10;The Center also assists students in exploring possible major options, in changing faculty advisors, in using a degree audit, class/lab schedule, and the St. Olaf Catalog for necessary information about fulfilling requirements.&#10;&#10;Academic Peer Advisors assist the Center.&#10;" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,520][996,626]" /></node><node index="2" text="" resource-id="" class="android.view.View" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,652][1038,873]"><node index="0" text="ACE" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,673][165,736]" /><node index="1" text="Academic Civic Engagement is an approach to teaching and learning that encourages students to learn in community contexts. Students consider community-based experiences in relation to classroom learning and apply academic knowledge and skills to strengthen communities as an integrated component of an academic course.&#10;" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,741][996,847]" /></node><node index="3" text="" resource-id="" class="android.view.View" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,873][1038,1094]"><node index="0" text="ACM" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,894][178,957]" /><node index="1" text="The Association for Computing Machinery is an international organization supporting the field of Computer Science. The recently accredited student chapter at St. Olaf aims to foster the computing community on campus through social events, workshops, talks, contests, demonstrations, tutoring, and community service.&#10;&#10;The activities and overall direction of the ACM are largely determined by the student members.&#10;" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,962][996,1068]" /></node><node index="4" text="" resource-id="" class="android.view.View" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1094][1038,1315]"><node index="0" text="ADC" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1115][169,1178]" /><node index="1" text="ADC stands for the After Dark Committee. As part of the Student Government Association, ADC is responsible for planning events for the student body. As the name describes, the committee handles events after dark. They plan events in the 10pm-2am time slot. Events have included paint parties in the Pause, Laser Tag, dances, and much more!&#10;" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1183][996,1289]" /></node><node index="5" text="" resource-id="" class="android.view.View" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1315][1038,1536]"><node index="0" text="Admissions" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1336][314,1399]" /><node index="1" text="This is where the St. Olaf journey begins. The Admissions Office guides future Ole prospects to see all the good in St. Olaf.&#10;" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1404][996,1510]" /></node><node index="6" text="" resource-id="" class="android.view.View" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1536][1038,1757]"><node index="0" text="Agnes A Cappella" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1557][427,1620]" /><node index="1" text="The female student a cappella group on campus. This is a very competitive group to become a part of because they are so highly liked by all of campus. The group holds concerts open to the public throughout the year. The campus favorite is the Holiday Concert where Agnes and the Limestones perform together.&#10;" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1625][996,1731]" /></node><node index="7" text="" resource-id="" class="android.view.View" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1757][1038,1978]"><node index="0" text="Alias" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1778][183,1841]" /><node index="1" text="The term for a group of email addresses made for an easier way to mass email. Professors use aliases for easy communication with their classes and students use aliases for easy communications with student organizations they participate in.&#10;" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1846][996,1952]" /></node><node index="8" text="" resource-id="" class="android.view.View" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1978][1038,2199]"><node index="0" text="AmCon" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1999][226,2062]" /><node index="1" text="Short for American Conversations, an interdisciplinary General Education program and learning community in which students analyze America’s history and culture.&#10;&#10;Over four successive semesters in their first and sophomore years, AmCon students encounter many of the texts, topics, and historical developments that have defined “America” from its earliest colonization to the present.&#10;&#10;AmCon students make up a true academic community, living in a common dorm in their first year and complementing their in-class education with dinners, informal gatherings and field trips. Through the inclusion of an academic civic engagement component, moreover, students develop as active citizens, bringing their ideas and energy into the larger community.&#10;" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,2067][996,2173]" /></node><node index="9" text="" resource-id="" class="android.view.View" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,2199][1038,2400]"><node index="0" text="ARMS" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,2220][203,2283]" /><node index="1" text="“American Racial and Multicultural Studies” is a program committed to the study of racial and cultural diversity within the United States. The major introduces students to the cultures, histories, and experiences of African Americans, Native Americans, Latinos, Asian Americans, and people of Middle Eastern descent.&#10;" resource-id="" class="android.widget.TextView" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,2288][996,2394]" /></node></node></node></node></node><node index="2" text="" resource-id="" class="android.widget.LinearLayout" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2169][1080,2400]"><node index="1" text="" resource-id="" class="e81" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2169][1080,2400]"><node index="0" text="" resource-id="" class="android.view.View" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2169][1080,2400]"><node index="0" text="" resource-id="" class="android.view.View" package="com.drewvolz.stolaf" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[477,2190][603,2316]" /></node></node></node></node></node></node></node></node></node></node></node></node></node></node></node></hierarchy>