{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "scripts/fixtures/",
    ".mise/",
    "assets/*.icon/",
    "source/features/mess/__fixtures__/mess.json"
  ],
  "useTabs": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": false,
  "semi": false,
  "overrides": [
    {
      "files": ["**/{*,.*}.json"],
      "options": {
        "useTabs": false,
        "tabWidth": 2
      }
    }
  ]
}
